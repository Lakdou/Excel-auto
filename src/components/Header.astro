---
import { CATEGORIES, CATEGORY_KEYS, SITE } from "../config";
import { url } from "../utils/posts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.replace(base, "") || "/";
const isCurrent = (match: string) => (match === "/" ? path === "/" : path.startsWith(match));
---

<header class="site-header">
  <div class="container header-row">
    <a class="logo" href={url("/")} aria-label={`${SITE.title}, accueil`}>
      <span class="logo-mark" aria-hidden="true">01</span>
      <span class="logo-text">{SITE.title}</span>
    </a>
    <nav class="nav" aria-label="Rubriques">
      <a href={url("/")} aria-current={isCurrent("/") ? "page" : undefined}>À la une</a>
      {CATEGORY_KEYS.map((key) => (
        <a href={url(`/categorie/${key}/`)} aria-current={isCurrent(`/categorie/${key}`) ? "page" : undefined}>
          <span class="dot-cat" style={`--cat: ${CATEGORIES[key].accent}`} aria-hidden="true"></span>{CATEGORIES[key].label}
        </a>
      ))}
      <a href={url("/blog/")} aria-current={isCurrent("/blog") ? "page" : undefined}>Tous les articles</a>
    </nav>
    <div class="header-tools">
      <a class="icon-btn" href={url("/blog/#search")} aria-label="Rechercher un article">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Changer de thème">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </div>
</header>
