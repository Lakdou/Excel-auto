---
import { SITE } from "../config";
import { url } from "../utils/posts";

const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";
const links = [
  { href: "/blog/", label: "Articles", match: "/blog" },
  { href: "/tags/", label: "Tags", match: "/tags" },
  { href: "/a-propos/", label: "À propos", match: "/a-propos", hideSm: true },
];
---

<header class="site-header">
  <div class="container">
    <a class="logo" href={url("/")} aria-label={`${SITE.title}, accueil`}>
      <span class="logo-mark" aria-hidden="true">01</span>
      <span class="logo-text">{SITE.title}</span>
    </a>
    <nav class="nav" aria-label="Navigation principale">
      {links.map((link) => (
        <a href={url(link.href)} class={link.hideSm ? "hide-sm" : undefined}
           aria-current={path.startsWith(link.match) ? "page" : undefined}>{link.label}</a>
      ))}
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Changer de thème">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </nav>
  </div>
</header>
