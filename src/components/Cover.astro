---
/**
 * Illustration de couverture générée (SVG), style esport : fond noir, halo et éclats anguleux de la couleur
 * de la rubrique, lignes de balayage, coins de viseur, nom de rubrique en filigrane et pictogramme « glitch ».
 * Unique et stable pour chaque article : les formes sont tirées d'un générateur pseudo-aléatoire initialisé
 * avec l'identifiant de l'article (même article = même image, à chaque build).
 */
import { CATEGORIES, type CategoryKey, type IconKey } from "../config";

interface Props {
  seed: string;
  category: CategoryKey;
  icon?: IconKey;
  class?: string;
  label?: string;
}

const { seed, category, icon: iconOverride, class: className, label } = Astro.props;
const cat = CATEGORIES[category];
const icon: IconKey = iconOverride ?? cat.icon;
const accent = cat.accent;
const glitch = category === "ia" ? "#ff2a3d" : "#00d4ff"; // couleur du décalage, contrastée avec l'accent

function hash(text: string): number {
  let h = 2166136261;
  for (let i = 0; i < text.length; i++) {
    h ^= text.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}
function random(seedValue: number) {
  let a = seedValue;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rnd = random(hash(seed));
const r = (min: number, max: number) => Math.round(min + rnd() * (max - min));
// Identifiants uniques dans la page (une même couverture peut apparaître plusieurs fois).
const uid = `c${hash(seed).toString(36)}${Math.floor(rnd() * 1e9).toString(36)}`;

const glow = { cx: r(250, 950), cy: r(120, 560), r: r(380, 560) };
const motif = ["stripes", "grid", "dots"][Math.floor(rnd() * 3)];
// Éclats anguleux (quadrilatères penchés), comme des affiches de tournoi.
const shards = Array.from({ length: 4 }, () => {
  const x = r(-150, 1100), y = r(-100, 600), w = r(120, 420), h = r(30, 140), skew = r(60, 220);
  return { points: `${x},${y + h} ${x + skew},${y} ${x + skew + w},${y} ${x + w},${y + h}`, o: (0.06 + rnd() * 0.22).toFixed(2) };
});
const slashY = r(80, 520);
const sparks = Array.from({ length: 10 }, () => ({ x: r(40, 1160), y: r(30, 645), w: r(10, 60) }));
const textY = r(560, 660);
const textX = r(-40, 120);
---

<svg
  class={className}
  viewBox="0 0 1200 675"
  preserveAspectRatio="xMidYMid slice"
  xmlns="http://www.w3.org/2000/svg"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  <defs>
    <linearGradient id={`${uid}-bg`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0b0b0e" />
      <stop offset="1" stop-color="#16161c" />
    </linearGradient>
    <radialGradient id={`${uid}-glow`}>
      <stop offset="0" stop-color={accent} stop-opacity=".55" />
      <stop offset=".55" stop-color={accent} stop-opacity=".12" />
      <stop offset="1" stop-color={accent} stop-opacity="0" />
    </radialGradient>
    <pattern id={`${uid}-motif`} width="40" height="40" patternUnits="userSpaceOnUse">
      {motif === "stripes" && <path d="M-10 10L10 -10M0 40L40 0M30 50L50 30" stroke={accent} stroke-opacity=".09" stroke-width="7" />}
      {motif === "grid" && <path d="M40 0H0V40" fill="none" stroke="#fff" stroke-opacity=".06" stroke-width="1.5" />}
      {motif === "dots" && <circle cx="20" cy="20" r="2" fill="#fff" fill-opacity=".12" />}
    </pattern>
    <pattern id={`${uid}-scan`} width="6" height="6" patternUnits="userSpaceOnUse">
      <rect width="6" height="2" fill="#000" fill-opacity=".28" />
    </pattern>
    <symbol id={`${uid}-icon`} viewBox="0 0 100 100" overflow="visible">
      <g fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="square" stroke-linejoin="miter">
        {icon === "gamepad" && (
          <>
            <path d="M30 34h40a18 18 0 0 1 17.6 14.2l4.8 22.4a9.5 9.5 0 0 1-16.8 7.9L67 68H33l-8.6 10.5a9.5 9.5 0 0 1-16.8-7.9l4.8-22.4A18 18 0 0 1 30 34z" />
            <path d="M31 46v14M24 53h14" />
            <rect x="64" y="45" width="6" height="6" fill="currentColor" stroke="none" />
            <rect x="72" y="53" width="6" height="6" fill="currentColor" stroke="none" />
          </>
        )}
        {icon === "ram" && (
          <>
            <rect x="8" y="30" width="84" height="32" />
            {[0, 1, 2, 3].map((i) => <rect x={14 + i * 19.5} y="37" width="13" height="18" fill="currentColor" stroke="none" />)}
            <path d="M14 62v9M20 62v9M26 62v9M32 62v9M38 62v9M44 62v9M56 62v9M62 62v9M68 62v9M74 62v9M80 62v9M86 62v9" stroke-width="2.4" />
          </>
        )}
        {icon === "neural" && (
          <>
            <path d="M20 30L50 22M20 30L50 42M20 30L50 58M20 50L50 22M20 50L50 42M20 50L50 58M20 50L50 78M20 70L50 58M20 70L50 78M20 70L50 42M50 22L80 40M50 42L80 40M50 42L80 60M50 58L80 40M50 58L80 60M50 78L80 60" stroke-width="1.8" />
            {[[20, 30], [20, 50], [20, 70], [50, 22], [50, 42], [50, 58], [50, 78], [80, 40], [80, 60]].map(([cx, cy]) => (
              <rect x={cx - 4.5} y={cy - 4.5} width="9" height="9" fill="currentColor" stroke="none" transform={`rotate(45 ${cx} ${cy})`} />
            ))}
          </>
        )}
        {icon === "code" && (
          <>
            <path d="M34 30L14 50l20 20M66 30l20 20-20 20" stroke-width="4.5" />
            <path d="M56 24L44 76" stroke-width="4.5" />
          </>
        )}
        {icon === "branch" && (
          <>
            <path d="M30 32v36M70 47c0 16-40 9-40 21" stroke-width="4.5" />
            <rect x="23" y="18" width="14" height="14" />
            <rect x="23" y="68" width="14" height="14" />
            <rect x="63" y="33" width="14" height="14" fill="currentColor" />
          </>
        )}
        {icon === "sheet" && (
          <>
            <rect x="16" y="20" width="68" height="60" />
            <rect x="16" y="20" width="68" height="14" fill="currentColor" stroke="none" />
            <path d="M16 50h68M16 65h68M38 34v46M61 34v46" stroke-width="2.4" />
          </>
        )}
        {icon === "rocket" && (
          <>
            <path d="M50 12c12 9 18 23 18 40l-7 12H39l-7-12c0-17 6-31 18-40z" />
            <rect x="45" y="35" width="10" height="10" fill="currentColor" stroke="none" />
            <path d="M32 50l-11 15 15-2M68 50l11 15-15-2M44 70l6 15 6-15" />
          </>
        )}
        {icon === "tower" && (
          <>
            <rect x="30" y="12" width="40" height="76" />
            <path d="M38 24h24M38 31h15" stroke-width="2.6" />
            <circle cx="50" cy="60" r="13" />
            <path d="M50 47v26M37 60h26" stroke-width="1.8" />
          </>
        )}
      </g>
    </symbol>
  </defs>

  <rect width="1200" height="675" fill={`url(#${uid}-bg)`} />
  <circle cx={glow.cx} cy={glow.cy} r={glow.r} fill={`url(#${uid}-glow)`} />
  <rect width="1200" height="675" fill={`url(#${uid}-motif)`} />
  {shards.map((s) => <polygon points={s.points} fill={accent} fill-opacity={s.o} />)}
  <polygon points={`-50,${slashY + 26} 1250,${slashY - 120} 1250,${slashY - 108} -50,${slashY + 38}`} fill={accent} fill-opacity=".55" />

  <text x={textX} y={textY} font-family="'Chakra Petch', sans-serif" font-weight="700" font-size="250"
        fill="none" stroke="#fff" stroke-opacity=".07" stroke-width="2" letter-spacing="-6">{cat.label.toUpperCase()}</text>

  {sparks.map((s) => <rect x={s.x} y={s.y} width={s.w} height="3" fill="#fff" fill-opacity=".35" />)}

  <!-- Pictogramme « glitch » : deux copies décalées sous la version blanche. -->
  <use href={`#${uid}-icon`} x="456" y="194" width="288" height="288" color={glitch} opacity=".75" transform="translate(-7 0)" />
  <use href={`#${uid}-icon`} x="456" y="194" width="288" height="288" color={accent} transform="translate(7 3)" />
  <use href={`#${uid}-icon`} x="456" y="194" width="288" height="288" color="#ffffff" />

  <!-- Coins de viseur -->
  <g fill="none" stroke={accent} stroke-width="6">
    <!-- placés à l'intérieur de la zone visible même en format très large (21:9) -->
    <path d="M40 165V95h70M1090 95h70v70M1160 510v70h-70M110 580H40v-70" />
  </g>
  <rect width="1200" height="675" fill={`url(#${uid}-scan)`} />
</svg>
