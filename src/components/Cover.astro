---
/**
 * Illustration de couverture générée (SVG) : unique et stable pour chaque article.
 * Couleurs et pictogramme selon la rubrique ; formes décoratives tirées d'un générateur pseudo-aléatoire
 * initialisé avec l'identifiant de l'article (même article = même image, à chaque build).
 */
import { CATEGORIES, type CategoryKey, type IconKey } from "../config";

interface Props {
  seed: string;
  category: CategoryKey;
  icon?: IconKey;
  class?: string;
  label?: string;
}

const { seed, category, icon: iconOverride, class: className, label } = Astro.props;
const cat = CATEGORIES[category];
const icon: IconKey = iconOverride ?? cat.icon;

function hash(text: string): number {
  let h = 2166136261;
  for (let i = 0; i < text.length; i++) {
    h ^= text.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}
function random(seedValue: number) {
  let a = seedValue;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rnd = random(hash(seed));
const r = (min: number, max: number) => Math.round(min + rnd() * (max - min));
// Identifiants uniques dans la page (une même couverture peut apparaître plusieurs fois).
const uid = `c${hash(seed).toString(36)}${Math.floor(rnd() * 1e9).toString(36)}`;

const angle = rnd() * Math.PI * 2;
const motif = ["grid", "dots", "diagonal"][Math.floor(rnd() * 3)];
const gx = (v: number) => (0.5 + Math.cos(angle) * v).toFixed(3);
const gy = (v: number) => (0.5 + Math.sin(angle) * v).toFixed(3);

const glows = Array.from({ length: 3 }, () => ({ cx: r(0, 1200), cy: r(0, 675), r: r(160, 360) }));
const dots = Array.from({ length: 14 }, () => ({ cx: r(40, 1160), cy: r(30, 645), r: r(2, 6), o: (0.25 + rnd() * 0.5).toFixed(2) }));
const rings = [150, 210, 280].map((radius) => ({ radius, dash: `${r(4, 18)} ${r(10, 30)}` }));
const lines = Array.from({ length: 4 }, () => {
  const y = r(0, 675);
  return { x1: -50, y1: y, x2: 1250, y2: y + r(-260, 260) };
});
---

<svg
  class={className}
  viewBox="0 0 1200 675"
  preserveAspectRatio="xMidYMid slice"
  xmlns="http://www.w3.org/2000/svg"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  <defs>
    <linearGradient id={`${uid}-bg`} x1={gx(-0.5)} y1={gy(-0.5)} x2={gx(0.5)} y2={gy(0.5)}>
      <stop offset="0" stop-color={cat.from} />
      <stop offset="1" stop-color={cat.to} />
    </linearGradient>
    <radialGradient id={`${uid}-glow`}>
      <stop offset="0" stop-color="#fff" stop-opacity=".38" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
    <pattern id={`${uid}-grid`} width="48" height="48" patternUnits="userSpaceOnUse">
      {motif === "grid" && <path d="M48 0H0V48" fill="none" stroke="#fff" stroke-opacity=".09" stroke-width="1.5" />}
      {motif === "dots" && <circle cx="24" cy="24" r="2.2" fill="#fff" fill-opacity=".16" />}
      {motif === "diagonal" && <path d="M-12 12L12 -12M0 48L48 0M36 60L60 36" stroke="#fff" stroke-opacity=".08" stroke-width="6" />}
    </pattern>
  </defs>

  <rect width="1200" height="675" fill={`url(#${uid}-bg)`} />
  <rect width="1200" height="675" fill={`url(#${uid}-grid)`} />
  {glows.map((g) => <circle cx={g.cx} cy={g.cy} r={g.r} fill={`url(#${uid}-glow)`} />)}
  {lines.map((l) => <line {...l} stroke="#fff" stroke-opacity=".10" stroke-width="2" />)}
  {rings.map((ring) => (
    <circle cx="600" cy="337" r={ring.radius} fill="none" stroke="#fff" stroke-opacity=".16" stroke-width="2" stroke-dasharray={ring.dash} />
  ))}
  {dots.map((d) => <circle cx={d.cx} cy={d.cy} r={d.r} fill="#fff" fill-opacity={d.o} />)}

  <g transform="translate(470 207) scale(2.6)" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
    {icon === "gamepad" && (
      <>
        <path d="M30 34h40a18 18 0 0 1 17.6 14.2l4.8 22.4a9.5 9.5 0 0 1-16.8 7.9L67 68H33l-8.6 10.5a9.5 9.5 0 0 1-16.8-7.9l4.8-22.4A18 18 0 0 1 30 34z" fill="#fff" fill-opacity=".12" />
        <path d="M31 46v14M24 53h14" />
        <circle cx="67" cy="48" r="3.2" fill="#fff" />
        <circle cx="75" cy="56" r="3.2" fill="#fff" />
        <circle cx="59" cy="56" r="3.2" fill="#fff" fill-opacity=".6" />
      </>
    )}
    {icon === "ram" && (
      <>
        <rect x="8" y="30" width="84" height="32" rx="3" fill="#fff" fill-opacity=".12" />
        {[0, 1, 2, 3].map((i) => <rect x={14 + i * 19.5} y="37" width="13" height="18" rx="1.5" fill="#fff" fill-opacity=".85" stroke="none" />)}
        <path d="M14 62v9M20 62v9M26 62v9M32 62v9M38 62v9M44 62v9M56 62v9M62 62v9M68 62v9M74 62v9M80 62v9M86 62v9" stroke-width="2.4" />
      </>
    )}
    {icon === "neural" && (
      <>
        <path d="M20 30L50 22M20 30L50 42M20 30L50 58M20 50L50 22M20 50L50 42M20 50L50 58M20 50L50 78M20 70L50 58M20 70L50 78M20 70L50 42M50 22L80 40M50 42L80 40M50 42L80 60M50 58L80 40M50 58L80 60M50 78L80 60" stroke-width="1.8" stroke-opacity=".75" />
        {[[20, 30], [20, 50], [20, 70], [50, 22], [50, 42], [50, 58], [50, 78], [80, 40], [80, 60]].map(([cx, cy]) => (
          <circle cx={cx} cy={cy} r="5" fill="#fff" stroke="none" />
        ))}
      </>
    )}
    {icon === "code" && (
      <>
        <path d="M34 30L14 50l20 20M66 30l20 20-20 20" stroke-width="4" />
        <path d="M56 24L44 76" stroke-width="4" stroke-opacity=".8" />
      </>
    )}
    {icon === "branch" && (
      <>
        <path d="M30 31v38M70 46c0 16-40 9-40 23" stroke-width="4" />
        <circle cx="30" cy="25" r="7" fill="#fff" fill-opacity=".15" />
        <circle cx="30" cy="75" r="7" fill="#fff" fill-opacity=".15" />
        <circle cx="70" cy="40" r="7" fill="#fff" />
      </>
    )}
    {icon === "sheet" && (
      <>
        <rect x="16" y="20" width="68" height="60" rx="5" fill="#fff" fill-opacity=".12" />
        <rect x="16" y="20" width="68" height="15" rx="5" fill="#fff" fill-opacity=".45" stroke="none" />
        <path d="M16 50h68M16 65h68M38 20v60M61 20v60" stroke-width="2.4" />
      </>
    )}
    {icon === "rocket" && (
      <>
        <path d="M50 12c12 9 18 23 18 40l-7 12H39l-7-12c0-17 6-31 18-40z" fill="#fff" fill-opacity=".14" />
        <circle cx="50" cy="40" r="6.5" fill="#fff" />
        <path d="M32 50l-11 15 15-2M68 50l11 15-15-2" />
        <path d="M44 70l6 15 6-15" stroke-opacity=".8" />
      </>
    )}
    {icon === "tower" && (
      <>
        <rect x="30" y="12" width="40" height="76" rx="5" fill="#fff" fill-opacity=".12" />
        <path d="M38 24h24M38 31h15" stroke-width="2.6" />
        <circle cx="50" cy="60" r="13" />
        <path d="M50 47v26M37 60h26M41 51l18 18M59 51L41 69" stroke-width="1.6" stroke-opacity=".7" />
      </>
    )}
  </g>
</svg>
