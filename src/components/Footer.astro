---
import { CATEGORIES, CATEGORY_KEYS, SITE } from "../config";
import { url } from "../utils/posts";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-about">
        <a class="logo" href={url("/")} aria-label={`${SITE.title}, accueil`}>
          <span class="logo-mark" aria-hidden="true">01</span>
          <span class="logo-text">{SITE.title}</span>
        </a>
        <p>{SITE.description}</p>
      </div>
      <nav aria-labelledby="footer-cats">
        <h2 id="footer-cats">Rubriques</h2>
        <ul>
          {CATEGORY_KEYS.map((key) => <li><a href={url(`/categorie/${key}/`)}>{CATEGORIES[key].label}</a></li>)}
        </ul>
      </nav>
      <nav aria-labelledby="footer-blog">
        <h2 id="footer-blog">Le blog</h2>
        <ul>
          <li><a href={url("/blog/")}>Tous les articles</a></li>
          <li><a href={url("/tags/")}>Tags</a></li>
          <li><a href={url("/a-propos/")}>À propos</a></li>
          <li><a href={url("/rss.xml")}>Flux RSS</a></li>
          <li><a href={SITE.links.github} rel="me noopener">GitHub</a></li>
        </ul>
      </nav>
    </div>
    <div class="footer-bottom">© {year} {SITE.author} · {SITE.title} — {SITE.tagline}</div>
  </div>
</footer>
