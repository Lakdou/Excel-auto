---
import type { Post } from "../utils/posts";
import { formatDate, readingTime, slugify, url } from "../utils/posts";

interface Props {
  post: Post;
  headingLevel?: "h2" | "h3";
}

const { post, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const minutes = readingTime(post.body);
---

<li class="post-card" data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(" ")}`.toLowerCase()}>
  <div class="meta">
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    <span class="dot">{minutes} min de lecture</span>
  </div>
  <Heading><a href={url(`/blog/${post.id}/`)}>{post.data.title}</a></Heading>
  <p>{post.data.description}</p>
  {post.data.tags.length > 0 && (
    <ul class="tags" aria-label="Tags">
      {post.data.tags.map((tag) => <li><a class="tag" href={url(`/tags/${slugify(tag)}/`)}>{tag}</a></li>)}
    </ul>
  )}
</li>
