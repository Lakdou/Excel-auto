---
import Cover from "./Cover.astro";
import CategoryBadge from "./CategoryBadge.astro";
import type { Post } from "../utils/posts";
import { formatDate, readingTime, url } from "../utils/posts";
import { CATEGORIES } from "../config";

interface Props {
  post: Post;
  variant?: "grid" | "compact" | "featured";
  headingLevel?: "h2" | "h3";
}

const { post, variant = "grid", headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const href = url(`/blog/${post.id}/`);
const { title, description, pubDate, category, tags } = post.data;
const search = `${title} ${description} ${tags.join(" ")} ${category}`.toLowerCase();
---

<article class={`post-card post-card--${variant}`} style={`--cat: ${CATEGORIES[category].accent}`} data-search={search} data-category={category}>
  <a class="post-card__media" href={href} tabindex="-1" aria-hidden="true">
    <Cover seed={post.id} category={category} icon={post.data.icon} class="cover" />
  </a>
  <div class="post-card__body">
    <CategoryBadge category={category} />
    <Heading class="post-card__title"><a href={href}>{title}</a></Heading>
    {variant !== "compact" && <p class="post-card__excerpt">{description}</p>}
    <div class="meta">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      {variant !== "compact" && <span class="dot">{readingTime(post.body)} min de lecture</span>}
    </div>
  </div>
</article>
