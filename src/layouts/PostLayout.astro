---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import Cover from "../components/Cover.astro";
import CategoryBadge from "../components/CategoryBadge.astro";
import PostCard from "../components/PostCard.astro";
import { CATEGORIES, SITE } from "../config";
import type { Post } from "../utils/posts";
import { formatDate, readingTime, slugify, url } from "../utils/posts";

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  related: Post[];
}

const { post, headings, related } = Astro.props;
const { title, description, pubDate, updatedDate, tags, category } = post.data;
const cat = CATEGORIES[category];
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={title} description={description} type="article" publishedTime={pubDate} tags={tags}>
  <header class="post-hero container">
    <nav class="crumbs" aria-label="Fil d'Ariane">
      <a href={url("/")}>Accueil</a><span aria-hidden="true">›</span>
      <a href={url(`/categorie/${category}/`)}>{cat.label}</a>
    </nav>
    <CategoryBadge category={category} />
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    <div class="byline">
      <span class="avatar" aria-hidden="true">{SITE.author.charAt(0).toUpperCase()}</span>
      <span>
        <strong>{SITE.author}</strong>
        <span class="meta">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {updatedDate && <span class="dot">mis à jour le <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>}
          <span class="dot">{readingTime(post.body)} min de lecture</span>
        </span>
      </span>
    </div>
  </header>

  <div class="container">
    <div class="post-cover">
      <Cover seed={post.id} category={category} icon={post.data.icon} class="cover" label={`Illustration de l'article, rubrique ${cat.label}`} />
    </div>

    <div class="post-layout">
      <article>
        <div class="prose">
          <slot />
        </div>
        {tags.length > 0 && (
          <div class="post-tags">
            <ul class="tags" aria-label="Tags">
              {tags.map((tag) => <li><a class="tag" href={url(`/tags/${slugify(tag)}/`)}>#{tag}</a></li>)}
            </ul>
          </div>
        )}
      </article>

      <aside class="toc" aria-label="Sommaire et partage">
        {toc.length > 1 && (
          <>
            <h2>Sommaire</h2>
            <ol>
              {toc.map((h) => <li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ol>
          </>
        )}
        <div class="share">
          <button type="button" class="btn" data-copy-link>Copier le lien</button>
        </div>
      </aside>
    </div>
  </div>

  {related.length > 0 && (
    <section class="related" aria-labelledby="related-title">
      <div class="container">
        <div class="section-head">
          <div><span class="kicker">Continuer la lecture</span><h2 id="related-title">À lire ensuite</h2></div>
          <a href={url(`/categorie/${category}/`)}>Rubrique {cat.label} →</a>
        </div>
        <div class="card-grid">{related.map((p) => <PostCard post={p} />)}</div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  // Surligne dans le sommaire la section en cours de lecture.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>(".toc a").forEach((a) => links.set(decodeURIComponent(a.hash.slice(1)), a));
  if (links.size && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((a) => a.classList.remove("active"));
        links.get(entry.target.id)?.classList.add("active");
      }
    }, { rootMargin: "-90px 0px -70% 0px" });
    links.forEach((_, id) => { const el = document.getElementById(id); if (el) observer.observe(el); });
  }

  // Bouton « Copier le lien »
  document.querySelector<HTMLButtonElement>("[data-copy-link]")?.addEventListener("click", async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const link = location.href.split("#")[0];
    try {
      await navigator.clipboard.writeText(link);
      button.textContent = "Lien copié !";
    } catch {
      button.textContent = "Copie impossible";
    }
    setTimeout(() => { button.textContent = "Copier le lien"; }, 1800);
  });
</script>
