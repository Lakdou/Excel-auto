---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getPosts, slugify, tagCounts, url, type Post } from "../../utils/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return tagCounts(posts).map(({ tag, slug }) => ({
    params: { tag: slug },
    props: { tag, posts: posts.filter((p) => p.data.tags.some((t) => slugify(t) === slug)) },
  }));
}

const { tag, posts } = Astro.props as { tag: string; posts: Post[] };
---

<BaseLayout title={`Tag : ${tag}`} description={`Tous les articles sur le thème « ${tag} ».`}>
  <div class="container main-pad">
    <header class="page-head">
      <nav class="crumbs" aria-label="Fil d'Ariane">
        <a href={url("/")}>Accueil</a><span aria-hidden="true">›</span><a href={url("/tags/")}>Tags</a>
      </nav>
      <h1>#{tag}</h1>
      <p>{posts.length} article{posts.length > 1 ? "s" : ""}.</p>
    </header>
    <div class="card-grid">{posts.map((post) => <PostCard post={post} />)}</div>
  </div>
</BaseLayout>
