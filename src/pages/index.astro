---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { CATEGORIES, CATEGORY_KEYS, SITE } from "../config";
import { featuredPost, getPosts, url } from "../utils/posts";

const posts = await getPosts();
const featured = featuredPost(posts);
const others = posts.filter((p) => p !== featured);
const side = others.slice(0, 3);
const latest = others.slice(3, 9);
const counts = Object.fromEntries(CATEGORY_KEYS.map((k) => [k, posts.filter((p) => p.data.category === k).length]));
---

<BaseLayout>
  <div class="container">
    <h1 class="visually-hidden">{SITE.title} — {SITE.tagline}</h1>
    {featured ? (
      <section class="home-top" aria-label="À la une">
        <PostCard post={featured} variant="featured" headingLevel="h2" />
        {side.length > 0 && (
          <aside class="side-list" aria-labelledby="side-title">
            <div class="section-head"><h2 id="side-title">À lire aussi</h2></div>
            {side.map((post) => <PostCard post={post} variant="compact" />)}
          </aside>
        )}
      </section>
    ) : (
      <p class="empty">Aucun article pour l'instant.</p>
    )}

    {latest.length > 0 && (
      <section class="section" aria-labelledby="latest-title">
        <div class="section-head">
          <div><span class="kicker">Le fil</span><h2 id="latest-title">Derniers articles</h2></div>
          <a href={url("/blog/")}>Tous les articles ({posts.length}) →</a>
        </div>
        <div class="card-grid">{latest.map((post) => <PostCard post={post} />)}</div>
      </section>
    )}

    <section class="section" aria-labelledby="cats-title">
      <div class="section-head">
        <div><span class="kicker">Explorer</span><h2 id="cats-title">Les rubriques</h2></div>
      </div>
      <div class="cat-tiles">
        {CATEGORY_KEYS.map((key) => {
          const cat = CATEGORIES[key];
          return (
            <a class="cat-tile" href={url(`/categorie/${key}/`)} style={`--cat: ${cat.accent}`}>
              <span class="count">{counts[key]} article{counts[key] > 1 ? "s" : ""}</span>
              <h3>{cat.label}</h3>
              <p>{cat.description}</p>
            </a>
          );
        })}
      </div>
    </section>

    <section class="section">
      <div class="cta-band">
        <div>
          <h2>Ne ratez aucun article</h2>
          <p>Abonnez-vous au flux RSS : les nouveautés arrivent directement dans votre lecteur.</p>
        </div>
        <a class="btn" href={url("/rss.xml")}>S'abonner au flux RSS</a>
      </div>
    </section>
  </div>
</BaseLayout>
