---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { CATEGORIES, CATEGORY_KEYS } from "../../config";
import { getPosts } from "../../utils/posts";

const posts = await getPosts();
---

<BaseLayout title="Tous les articles" description="Tous les articles du blog, du plus récent au plus ancien, avec recherche et filtres par rubrique.">
  <div class="container main-pad">
    <header class="page-head">
      <h1>Tous les articles</h1>
      <p>{posts.length} article{posts.length > 1 ? "s" : ""}, du plus récent au plus ancien.</p>
      <div class="filters" role="group" aria-label="Filtrer les articles">
        <label class="visually-hidden" for="search">Rechercher un article</label>
        <input id="search" class="search" type="search" placeholder="Rechercher (titre, sujet, tag)…" autocomplete="off" />
        <button type="button" class="chip" data-filter="" aria-pressed="true">Tout</button>
        {CATEGORY_KEYS.map((key) => (
          <button type="button" class="chip" data-filter={key} aria-pressed="false">
            <span class="dot-cat" style={`--cat: ${CATEGORIES[key].accent}`} aria-hidden="true"></span>{CATEGORIES[key].label}
          </button>
        ))}
      </div>
    </header>

    <div class="card-grid" id="results">{posts.map((post) => <PostCard post={post} />)}</div>
    <p class="empty" id="no-result" hidden>Aucun article ne correspond à votre recherche.</p>
  </div>
</BaseLayout>

<script>
  // Recherche instantanée et filtre par rubrique (sans serveur).
  const input = document.querySelector<HTMLInputElement>("#search");
  const empty = document.querySelector<HTMLElement>("#no-result");
  const chips = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
  const normalize = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
  let category = "";

  function apply() {
    const terms = normalize(input?.value ?? "").split(/\s+/).filter(Boolean);
    let visible = 0;
    document.querySelectorAll<HTMLElement>("#results .post-card").forEach((card) => {
      const haystack = normalize(card.dataset.search ?? "");
      const match = terms.every((t) => haystack.includes(t)) && (!category || card.dataset.category === category);
      card.hidden = !match;
      if (match) visible++;
    });
    if (empty) empty.hidden = visible > 0;
  }

  input?.addEventListener("input", apply);
  chips.forEach((chip) => chip.addEventListener("click", () => {
    category = chip.dataset.filter ?? "";
    chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
    apply();
  }));
  if (location.hash === "#search") input?.focus();
</script>
