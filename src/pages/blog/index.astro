---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getPosts } from "../../utils/posts";

const posts = await getPosts();
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.pubDate.getUTCFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
---

<BaseLayout title="Articles" description="Tous les articles du blog, du plus récent au plus ancien.">
  <div class="container narrow">
    <header class="page-head">
      <h1>Articles</h1>
      <p>{posts.length} article{posts.length > 1 ? "s" : ""}, du plus récent au plus ancien.</p>
      <label class="visually-hidden" for="search">Rechercher un article</label>
      <input id="search" class="search" type="search" placeholder="Rechercher (titre, sujet, tag)…" autocomplete="off" />
      <p class="empty" id="no-result" hidden>Aucun article ne correspond à votre recherche.</p>
    </header>

    {[...byYear.entries()].map(([year, list]) => (
      <section class="year-group" aria-labelledby={`y-${year}`}>
        <h2 class="year" id={`y-${year}`}>{year}</h2>
        <ul class="post-list">{list.map((post) => <PostCard post={post} headingLevel="h3" />)}</ul>
      </section>
    ))}
    {posts.length === 0 && <p class="empty">Aucun article pour l'instant.</p>}
  </div>
</BaseLayout>

<script>
  // Filtre instantané des articles (sans serveur).
  const input = document.querySelector<HTMLInputElement>("#search");
  const empty = document.querySelector<HTMLElement>("#no-result");
  const normalize = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
  input?.addEventListener("input", () => {
    const terms = normalize(input.value).split(/\s+/).filter(Boolean);
    let visible = 0;
    document.querySelectorAll<HTMLElement>(".year-group").forEach((group) => {
      let groupVisible = 0;
      group.querySelectorAll<HTMLElement>(".post-card").forEach((card) => {
        const haystack = normalize(card.dataset.search ?? "");
        const match = terms.every((t) => haystack.includes(t));
        card.hidden = !match;
        if (match) groupVisible++;
      });
      group.hidden = groupVisible === 0;
      visible += groupVisible;
    });
    if (empty) empty.hidden = visible > 0;
  });
</script>
